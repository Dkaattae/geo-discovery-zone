{
  "name": "question-bank",
  "private": true,
  "type": "module",
  "description": "Build-time pipeline that turns structured facts into the geo quiz entity + question bank.",
  "scripts": {
    "build": "bun run src/build.ts",
    "build:sample": "bun run src/build.ts --offline --states CO --out sample-data",
    "refresh": "bun run src/refresh.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives --format default src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxlint": "^1.86.0",
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  }
}
