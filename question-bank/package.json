{
  "name": "question-bank",
  "private": true,
  "type": "module",
  "description": "Build-time pipeline that turns structured facts into the geo quiz entity + question bank.",
  "scripts": {
    "build": "bun run src/build.ts",
    "refresh": "bun run src/refresh.ts",
    "questions": "bun run src/write-questions.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives --format default src",
    "format": "bun run src/prettier-pin-guard.ts && prettier --write \"src/**/*.ts\"",
    "format:check": "bun run src/prettier-pin-guard.ts && prettier --check \"src/**/*.ts\"",
    "test:snapshots": "bun test ./src/*.snapshot.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxlint": "^1.86.0",
    "prettier": "3.9.6",
    "typescript": "^7.0.2"
  }
}
